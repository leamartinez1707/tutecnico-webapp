# MercadoPago Configuration Example
# Copia este archivo a .env y completa con tus credenciales

# MercadoPago Access Token
# Obtén tu token en: https://www.mercadopago.com.uy/developers/panel/credentials
MERCADOPAGO_ACCESS_TOKEN=TEST-1234567890-123456-abcdefg1234567890-123456789

# URLs de la aplicación
BACKEND_URL=http://localhost:3000
FRONTEND_URL=http://localhost:3001

# Para producción, usa tus credenciales de producción:
# MERCADOPAGO_ACCESS_TOKEN=APP_USR-1234567890-123456-abcdefg1234567890-123456789
